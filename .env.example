# Copy to .env and adjust. docker-compose injects service-specific
# DATABASE_URL/REDIS_URL/S3_* values; these are used for host-side tooling.

# --- LLM / embeddings (OpenAI-compatible endpoints) ---
# Default: the authenticated local model queue on the host (port 11435;
# the bare Ollama port 11434 is retired). Get the key from the queue owner.
LLM_BASE_URL=http://host.docker.internal:11435/v1
LLM_API_KEY=
LLM_MODEL=cockpit/kat8
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Set to "false" to force heuristic fallbacks (no external calls).
LLM_ENABLED=true

# --- Alerts (all optional; undelivered alerts stay queued in DB) ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Minimum priority score (0-1) that generates an alert.
ALERT_THRESHOLD=0.75

# --- Source API tokens (optional, raise rate limits) ---
GITHUB_TOKEN=
NVD_API_KEY=

# --- App ---
PROCESSING_VERSION=0.2.0
CORS_ORIGINS=http://localhost:3000

# Required for any mutating API call (x-api-key header). Generate with: openssl rand -hex 32
API_WRITE_KEY=
